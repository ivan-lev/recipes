+/// Find a cover image for a directory, stored next to it with the same stem
+/// (`Salads/` -> `Salads.jpg`), the same way a recipe's title image sits next
+/// to its `.cook` file.
+fn find_directory_image(dir: &Utf8Path) -> Option<Utf8PathBuf> {
+    let parent = dir.parent()?;
+    let name = dir.file_name()?;
+    ["jpg", "jpeg", "png", "webp"]
+        .iter()
+        .map(|ext| parent.join(format!("{name}.{ext}")))
+        .find(|path| path.is_file())
